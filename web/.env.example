# Copy to web/.env.local for dev.

# Browser-visible (exposed to client bundle).
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# Operator section switches — one per top-level section. Set to FALSE to HIDE a
# section from the nav and block its routes; a section is shown unless its var is
# FALSE (unset/TRUE = shown). Server-side only (NO NEXT_PUBLIC_ prefix) and read at
# runtime, so a change takes effect on the next deploy/boot — no rebuild needed.
# Restart the dev server after editing here.
FEATURE_RADAR=TRUE
FEATURE_MYSTERY_DRIVER=TRUE
FEATURE_RACE=TRUE
FEATURE_PIPELINE=TRUE

# Server-side only (used by React Server Components for fetch).
# In Vercel + Railway prod, this is the Railway public URL.
API_BASE_INTERNAL=http://localhost:8000
