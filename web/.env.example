# Copy to web/.env.local for dev.

# Browser-visible (exposed to client bundle).
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# Operator feature kill-switch: comma-separated feature keys to HIDE from the
# nav and block their routes. Unset = all features enabled. Server-side only
# (NO NEXT_PUBLIC_ prefix) and read at runtime, so changing it takes effect on the
# next deploy/boot — no rebuild needed. Restart the dev server after editing here.
# Keys: radar, mystery-driver, race, pipeline
DISABLED_FEATURES=mystery-driver,pipeline

# Server-side only (used by React Server Components for fetch).
# In Vercel + Railway prod, this is the Railway public URL.
API_BASE_INTERNAL=http://localhost:8000
