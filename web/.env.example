# Copy to web/.env.local for dev.

# Browser-visible (exposed to client bundle).
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# Server-side only (used by React Server Components for fetch).
# In Vercel + Railway prod, this is the Railway public URL.
API_BASE_INTERNAL=http://localhost:8000
