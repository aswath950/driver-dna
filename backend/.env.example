# --- Environment ---
ENV=local
LOG_LEVEL=INFO

# --- Database (async URL for app; sync URL for Alembic migrations) ---
DATABASE_URL=postgresql+asyncpg://dna:dna@localhost:5432/driver_dna
DATABASE_URL_SYNC=postgresql+psycopg://dna:dna@localhost:5432/driver_dna

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me

# --- OpenF1 ---
OPENF1_BASE_URL=https://api.openf1.org/v1

# --- CORS (comma-separated origin allowlist; include local web + Vercel preview wildcard) ---
CORS_ORIGINS=http://localhost:3000

# --- Cookies (sign user_sessions cookie; generate via `openssl rand -hex 32`) ---
COOKIE_SECRET=dev-secret-change-me

# --- Rate limiting ---
RATE_LIMIT_PER_MIN=60
