# FastF1 cache — files can be several GB
data/*
!data/.gitkeep
data/.google_token.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Trained model artifacts — regenerate with `python src/model.py`
models/*
!models/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env files
.env
.streamlit/secrets.toml

# Claude Code local settings (contain absolute user paths)
.claude/

# Monorepo: backend (FastAPI)
backend/.venv/
backend/.env
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/.coverage

# Monorepo: web (Next.js)
web/node_modules/
web/.next/
web/out/
web/.env.local
web/.env*.local
web/.vercel
